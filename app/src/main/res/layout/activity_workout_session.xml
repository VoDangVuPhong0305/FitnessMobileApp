<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootWorkoutSession"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Chức năng: màn chuẩn bị và màn tập chính của buổi tập -->
    <LinearLayout
        android:id="@+id/layoutMainSession"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="26dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp">

        <!-- Chức năng: thanh trên cùng, gồm nút quay lại và thông tin tiến trình bài tập -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Chức năng: nút quay lại bằng icon drawable -->
            <ImageView
                android:id="@+id/btnCloseSession"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:adjustViewBounds="true"
                android:contentDescription="Quay lại"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_back"
                app:tint="#B0B0B0" />

            <!-- Chức năng: hiển thị dạng 1/7, 2/6,... -->
            <TextView
                android:id="@+id/txtSessionInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text=""
                android:textColor="#999999"
                android:textSize="26sp"/>

            <!-- Chức năng: giữ bố cục cân đối vì bên phải không có nút tương ứng -->
            <Space
                android:layout_width="32dp"
                android:layout_height="32dp" />

        </LinearLayout>

        <!-- Chức năng: khung hiển thị video/hoạt hình bài tập hiện tại.
             Giữ khung vuông bình thường để VideoView hiển thị ổn định. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="292dp"
            android:layout_marginTop="14dp"
            android:background="#FFFFFF">

            <!-- Chức năng: video/hoạt hình bài tập chính -->
            <VideoView
                android:id="@+id/videoSessionExercise"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Chức năng: thông báo khi bài tập không có hoạt hình -->
            <TextView
                android:id="@+id/txtSessionEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Chưa có hoạt hình"
                android:textColor="#999999"
                android:textSize="18sp"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Chức năng: tạo khoảng cách giữa video và cụm chữ bên dưới -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="28dp" />

        <!-- Chức năng: tiêu đề trạng thái hiện tại của buổi tập -->
        <TextView
            android:id="@+id/txtPhaseTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="ĐÃ SẴN SÀNG TẬP"
            android:textColor="#222222"
            android:textSize="29sp"/>

        <!-- Chức năng: tên bài tập hiện tại -->
        <TextView
            android:id="@+id/txtSessionExerciseName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="LEO NÚI"
            android:textColor="#18C27A"
            android:textSize="30sp"/>

        <!-- Chức năng: hiển thị số đếm chuẩn bị hoặc thời gian/số lần tập -->
        <TextView
            android:id="@+id/txtSessionTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="10"
            android:textColor="#111111"
            android:textSize="98sp"/>

        <!-- Chức năng: khoảng trống co giãn để giữ nút BẮT ĐẦU NGAY ở phía dưới -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Chức năng: nút bắt đầu nhanh bài tập hiện tại -->
        <TextView
            android:id="@+id/btnStartNow"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginStart="42dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="42dp"
            android:background="@drawable/bg_session_gray_button"
            android:gravity="center"
            android:text="BẮT ĐẦU NGAY"
            android:textColor="#666666"
            android:textSize="18sp"/>

        <!-- Chức năng: cụm điều khiển khi đang tập, gồm TẠM DỪNG/XONG, Trước đó và Bỏ qua -->
        <LinearLayout
            android:id="@+id/layoutExerciseControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnPauseResume"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginStart="42dp"
                android:layout_marginEnd="42dp"
                android:background="@drawable/bg_session_gray_button"
                android:gravity="center"
                android:text="Ⅱ  TẠM DỪNG"
                android:textColor="#666666"
                android:textSize="18sp"/>

            <FrameLayout
                android:id="@+id/layoutExerciseNavigation"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="36dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="36dp">

                <!-- Chức năng: vạch chia giữa hai nút Trước đó và Bỏ qua -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:background="#DDDDDD" />

                <!-- Chức năng: quay lại bài tập trước đó -->
                <TextView
                    android:id="@+id/btnPreviousExercise"
                    android:layout_width="200dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical|center_horizontal"
                    android:ellipsize="none"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="←  Trước đó"
                    android:textColor="#777777"
                    android:textSize="19sp"
                    android:translationX="-90dp" />

                <!-- Chức năng: bỏ qua bài hiện tại để sang bài tiếp theo -->
                <TextView
                    android:id="@+id/btnSkip"
                    android:layout_width="190dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical|center_horizontal"
                    android:ellipsize="none"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Bỏ qua  →"
                    android:textColor="#777777"
                    android:textSize="19sp"
                    android:translationX="90dp" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Chức năng: màn nghỉ ngơi giữa các bài tập -->
    <LinearLayout
        android:id="@+id/layoutRestScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#252B35"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Chức năng: phần trên của màn nghỉ, hiển thị tiêu đề và thời gian nghỉ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#252B35">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <TextView
                    android:id="@+id/txtRestTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Nghỉ ngơi"
                    android:textColor="#6AF174"
                    android:textSize="34sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="126dp"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <!-- Chức năng: cộng thêm thời gian nghỉ -->
                    <TextView
                        android:id="@+id/btnAddRestTime"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rest_action_button"
                        android:gravity="center"
                        android:text="+20s"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"/>

                    <!-- Chức năng: hiển thị số giây nghỉ còn lại -->
                    <TextView
                        android:id="@+id/txtRestTimer"
                        android:layout_width="0dp"
                        android:layout_height="126dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1.25"
                        android:gravity="center"
                        android:text="10"
                        android:textColor="#FFFFFF"
                        android:textSize="76sp"/>

                    <!-- Chức năng: bỏ qua thời gian nghỉ để sang bài tiếp theo -->
                    <TextView
                        android:id="@+id/btnSkipRest"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rest_action_button"
                        android:gravity="center"
                        android:text="BỎ QUA"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"/>

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

        <!-- Chức năng: phần dưới màn nghỉ, hiển thị bài tập tiếp theo -->
        <LinearLayout
            android:id="@+id/layoutNextExerciseCard"
            android:layout_width="match_parent"
            android:layout_height="460dp"
            android:background="@drawable/bg_rest_bottom_card"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="30dp"
            android:paddingEnd="26dp"
            android:paddingBottom="26dp">

            <TextView
                android:id="@+id/txtRestNextInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tiếp theo 2/7"
                android:textColor="#9B9B9B"
                android:textSize="23sp"/>

            <TextView
                android:id="@+id/txtRestNextName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Chống đẩy 00:30"
                android:textColor="#555555"
                android:textSize="26sp"/>

            <!-- Chức năng: khung xem trước bài tiếp theo ở màn nghỉ.
                 Giữ khung vuông bình thường để VideoView hiển thị ổn định. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="18dp"
                android:layout_weight="1"
                android:background="#FFFFFF">

                <!-- Chức năng: video xem trước bài tập tiếp theo ở màn nghỉ -->
                <VideoView
                    android:id="@+id/videoRestNextExercise"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Chức năng: thông báo khi bài tiếp theo không có hoạt hình -->
                <TextView
                    android:id="@+id/txtRestNextEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Chưa có hoạt hình"
                    android:textColor="#999999"
                    android:textSize="16sp"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Chức năng: nút dấu hỏi để mở màn gợi ý/cách tập bài hiện tại -->
    <TextView
        android:id="@+id/btnExerciseHelp"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="92dp"
        android:layout_marginEnd="22dp"
        android:elevation="8dp"
        android:gravity="center"
        android:text="\?"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"/>

</FrameLayout>