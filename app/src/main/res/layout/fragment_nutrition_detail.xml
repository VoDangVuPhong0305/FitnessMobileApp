<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:fitsSystemWindows="true">
    <!-- Toolbar -->
    <include
        android:id="@+id/header"
        layout="@layout/toolbar"/>
    <!-- Nội dung -->
    <ScrollView
        android:id="@+id/scrollDetail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Chế độ ăn -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStandard"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Tiêu chuẩn"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#20C76F"
                    app:cornerRadius="25dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVegetarian"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Ăn chay"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#666666"
                    android:backgroundTint="#FFFFFF"
                    app:cornerRadius="25dp"/>

            </LinearLayout>

            <!-- Nội dung -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Bữa sáng -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="3dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeColor="#EEEEEE"
                        app:strokeWidth="1dp">

                        <TextView
                            android:id="@+id/tvBreakfast"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="18dp"
                            android:textColor="#222222"
                            android:textSize="17sp"
                            android:lineSpacingExtra="4dp" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Bữa nhẹ -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="3dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeColor="#EEEEEE"
                        app:strokeWidth="1dp">

                        <TextView
                            android:id="@+id/tvSnack"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="18dp"
                            android:textColor="#222222"
                            android:textSize="17sp"
                            android:lineSpacingExtra="4dp" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Bữa trưa -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="3dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeColor="#EEEEEE"
                        app:strokeWidth="1dp">

                        <TextView
                            android:id="@+id/tvLunch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="18dp"
                            android:textColor="#222222"
                            android:textSize="17sp"
                            android:lineSpacingExtra="4dp" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Bữa tối -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="3dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeColor="#EEEEEE"
                        app:strokeWidth="1dp">

                        <TextView
                            android:id="@+id/tvDinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="18dp"
                            android:textColor="#222222"
                            android:textSize="17sp"
                            android:lineSpacingExtra="4dp" />
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>

            <!-- Hoàn thành -->
            <ImageView
                android:id="@+id/btnCheck"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="14dp"
                android:src="@drawable/ic_check_green"
                android:contentDescription="Hoàn thành"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>