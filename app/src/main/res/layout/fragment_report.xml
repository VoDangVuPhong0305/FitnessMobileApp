<?xml version="1.0" encoding="utf-8"?>
<!-- Kim Tuyền - Màn hình Báo cáo: Lịch + Cân nặng cùng màn hình -->

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEEEEE">

    <View
        android:id="@+id/topBackground"
        android:layout_width="0dp"
        android:layout_height="245dp"
        android:background="#F4E9FF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/headerReport"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingTop="46dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtReportTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/anton_regular"
            android:includeFontPadding="false"
            android:text="BÁO CÁO"
            android:textColor="#222222"
            android:textSize="30sp"
            android:textStyle="normal" />

        <LinearLayout
            android:id="@+id/layoutQuickTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tabCalendar"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Tab lịch">

                <TextView
                    android:id="@+id/txtTabCalendar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/anton_regular"
                    android:includeFontPadding="false"
                    android:text="Lịch"
                    android:textColor="#111111"
                    android:textSize="24sp"
                    android:textStyle="normal" />

                <View
                    android:id="@+id/lineCalendar"
                    android:layout_width="46dp"
                    android:layout_height="5dp"
                    android:layout_marginTop="8dp"
                    android:background="#111111" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabWeight"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="46dp"
                android:minWidth="96dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Tab cân nặng">

                <TextView
                    android:id="@+id/txtTabWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/anton_regular"
                    android:includeFontPadding="false"
                    android:text="Cân nặng"
                    android:textColor="#999999"
                    android:textSize="24sp"
                    android:textStyle="normal" />

                <View
                    android:id="@+id/lineWeight"
                    android:layout_width="92dp"
                    android:layout_height="5dp"
                    android:layout_marginTop="8dp"
                    android:background="#00FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollReport"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingBottom="24dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/headerReport"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layoutReportContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="5dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSummary"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtTotalDays"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#18C27A"
                            android:textSize="34sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Buổi tập"
                            android:textColor="#111111"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="50dp"
                        android:background="#EEEEEE" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtTotalCalories"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#18C27A"
                            android:textSize="34sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kcal"
                            android:textColor="#111111"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="50dp"
                        android:background="#EEEEEE" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtTotalMinutes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#18C27A"
                            android:textSize="34sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Phút"
                            android:textColor="#111111"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCalendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:id="@+id/txtSelectedDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="1/7/2026"
                        android:textColor="#111111"
                        android:textSize="26sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/txtCalendarMonth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="thg 7 2026"
                        android:textColor="#111111"
                        android:textSize="21sp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false" />

                    <GridLayout
                        android:id="@+id/gridReportCalendar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:columnCount="7"
                        android:rowCount="7" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lịch sử tập luyện"
                        android:textColor="#111111"
                        android:textSize="24sp"/>

                    <ScrollView
                        android:id="@+id/scrollWorkoutHistory"
                        android:layout_width="match_parent"
                        android:layout_height="330dp"
                        android:layout_marginTop="14dp"
                        android:contentDescription="Danh sách lịch sử tập luyện"
                        android:fillViewport="false"
                        android:overScrollMode="ifContentScrolls"
                        android:scrollbars="vertical">

                        <LinearLayout
                            android:id="@+id/layoutWorkoutHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </ScrollView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp">

                    <!-- Tiêu đề cân nặng -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cân nặng"
                            android:textColor="#111111"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="(kg)"
                            android:textColor="#888888"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/btnAddWeight"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="#18A865"
                            android:textSize="30sp"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <!-- 3 thông số cân nặng -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hiện tại"
                                android:textColor="#666666"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif" />

                            <TextView
                                android:id="@+id/txtCurrentWeight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="0.0"
                                android:textColor="#111111"
                                android:textSize="28sp"
                                android:fontFamily="sans-serif"
                                android:includeFontPadding="false" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="48dp"
                            android:background="#EEEEEE" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="30 ngày trước"
                                android:textColor="#666666"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif" />

                            <TextView
                                android:id="@+id/txtLast30Days"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="0.0"
                                android:textColor="#111111"
                                android:textSize="28sp"
                                android:fontFamily="sans-serif"
                                android:includeFontPadding="false" />

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="48dp"
                            android:background="#EEEEEE" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Trung bình"
                                android:textColor="#666666"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif" />

                            <TextView
                                android:id="@+id/txtAverageWeight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="0.0"
                                android:textColor="#111111"
                                android:textSize="28sp"
                                android:fontFamily="sans-serif"
                                android:includeFontPadding="false" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Biểu đồ cân nặng -->
                    <FrameLayout
                        android:id="@+id/layoutWeightLineChart"
                        android:layout_width="match_parent"
                        android:layout_height="210dp"
                        android:layout_marginTop="8dp"
                        android:background="#FFFFFF" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBmi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="22dp">

                    <!-- Hàng tiêu đề BMI + đơn vị + nút chỉnh sửa -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/txtBMITitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/anton_regular"
                                android:includeFontPadding="false"
                                android:text="BMI"
                                android:textColor="#111111"
                                android:textSize="24sp"/>

                            <TextView
                                android:id="@+id/txtBMIUnit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="(kg/m²)"
                                android:textColor="#777777"
                                android:textSize="12sp"
                                android:textStyle="normal"
                                android:fontFamily="sans-serif"
                                android:includeFontPadding="false" />
                        </LinearLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/btnEditWeight"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:minHeight="48dp"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:paddingEnd="0dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="Chỉnh sửa ✎"
                            android:textColor="#777777"
                            android:textSize="13sp"
                            android:textStyle="normal"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/bmiScaleContainer"
                        android:layout_width="match_parent"
                        android:layout_height="78dp"
                        android:layout_marginTop="18dp">

                        <TextView
                            android:id="@+id/txtBMIMarker"
                            android:layout_width="54dp"
                            android:layout_height="30dp"
                            android:gravity="center"
                            android:text="24.2"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="16dp"
                            android:layout_gravity="bottom"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="3.5"
                                android:layout_marginEnd="3dp"
                                android:background="#75BDE3" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="6.5"
                                android:layout_marginEnd="3dp"
                                android:background="#63D44B" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="5"
                                android:layout_marginEnd="3dp"
                                android:background="#F2D22E" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="5"
                                android:layout_marginEnd="3dp"
                                android:background="#E89A2E" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="5"
                                android:background="#D9231F" />
                        </LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3.5"
                            android:text="15"
                            android:textColor="#999999"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="6.5"
                            android:text="18.5"
                            android:textColor="#999999"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="5"
                            android:text="25"
                            android:textColor="#999999"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="5"
                            android:text="30"
                            android:textColor="#999999"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="5"
                            android:gravity="end"
                            android:text="40"
                            android:textColor="#999999"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif" />
                    </LinearLayout>

                    <!-- Chỉ hiển thị tình trạng BMI, vẫn giữ txtBMIValue ẩn để Kotlin không bị lỗi -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtBMIValue"
                            android:layout_width="1dp"
                            android:layout_height="1dp"
                            android:visibility="gone"
                            android:text="24.2" />

                        <TextView
                            android:id="@+id/txtBMIStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đủ cân"
                            android:textColor="#46C7C7"
                            android:textSize="15sp"
                            android:textStyle="normal"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCalories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Calo đã đốt cháy"
                            android:textColor="#111111"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="(Kcal)"
                            android:textColor="#888888"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtCaloriesToday"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Hôm nay: 0 Kcal"
                        android:textColor="#18C27A"
                        android:textSize="17sp"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false" />

                    <LinearLayout
                        android:id="@+id/layoutCaloriesChart"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginTop="12dp"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:paddingTop="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="bottom|center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtCalValue1"
