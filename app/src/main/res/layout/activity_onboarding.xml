<?xml version="1.0" encoding="utf-8"?>
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/layoutOnboardingRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="48dp"
        android:paddingEnd="28dp"
        android:paddingBottom="28dp">

        <!-- HEADER: nút quay lại - thanh tiến trình - bỏ qua -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="7dp"
                android:src="@drawable/ic_arrow_back" />

            <FrameLayout
                android:id="@+id/layoutProgressWrap"
                android:layout_width="150dp"
                android:layout_height="7dp"
                android:layout_centerInParent="true"
                android:background="#EEEEEE">

                <View
                    android:id="@+id/progressFill"
                    android:layout_width="20dp"
                    android:layout_height="match_parent"
                    android:background="#8ADE8E" />
            </FrameLayout>

            <TextView
                android:id="@+id/btnSkip"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:text="Bỏ qua"
                android:textColor="#777777"
                android:textSize="17sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- CÂU HỎI -->
        <TextView
            android:id="@+id/txtQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Điều gì thúc đẩy bạn nhiều nhất?"
            android:textColor="#111111"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- MÔ TẢ PHỤ -->
        <TextView
            android:id="@+id/txtDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Tạo kế hoạch tập luyện phù hợp với bạn nhất"
            android:textColor="#999999"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- NỘI DUNG -->
        <LinearLayout
            android:id="@+id/layoutContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="38dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- OPTION 1 -->
            <TextView
                android:id="@+id/option1"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_unit_unselected"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="💪  Có dáng đẹp"
                android:textColor="#333333"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- OPTION 2 -->
            <TextView
                android:id="@+id/option2"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_unit_unselected"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="⭐  Để trông tốt hơn trong ảnh"
                android:textColor="#333333"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- OPTION 3 -->
            <TextView
                android:id="@+id/option3"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_unit_unselected"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="😺  Cảm thấy tự tin"
                android:textColor="#333333"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- OPTION 4 -->
            <TextView
                android:id="@+id/option4"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_unit_unselected"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="🏃  Khả năng thể thao tốt hơn"
                android:textColor="#333333"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- OPTION 5 -->
            <TextView
                android:id="@+id/option5"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:background="@drawable/bg_unit_unselected"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="😊  Giải tỏa căng thẳng"
                android:textColor="#333333"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- CUSTOM PICKER: năm sinh / chiều cao / cân nặng -->
            <FrameLayout
                android:id="@+id/layoutCustomPicker"
                android:layout_width="match_parent"
                android:layout_height="245dp"
                android:visibility="gone">

                <!-- Phần kéo số luôn nằm chính giữa màn hình -->
                <LinearLayout
                    android:layout_width="250dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtPickerPrev"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:gravity="center"
                        android:text="69.9"
                        android:textColor="#B8B8B8"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="190dp"
                        android:layout_height="2dp"
                        android:background="#777777" />

                    <TextView
                        android:id="@+id/txtPickerCurrent"
                        android:layout_width="match_parent"
                        android:layout_height="82dp"
                        android:gravity="center"
                        android:text="70.0"
                        android:textColor="#111111"
                        android:textSize="46sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="190dp"
                        android:layout_height="2dp"
                        android:background="#777777" />

                    <TextView
                        android:id="@+id/txtPickerNext"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:gravity="center"
                        android:text="70.1"
                        android:textColor="#B8B8B8"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Đơn vị nằm lệch hẳn sang phải, không làm lệch thanh kéo -->
                <TextView
                    android:id="@+id/txtUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end|center_vertical"
                    android:gravity="center"
                    android:paddingEnd="18dp"
                    android:text="kg"
                    android:textColor="#999999"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- KHỐI BMI -->
            <LinearLayout
                android:id="@+id/layoutBmi"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_bmi_card"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtBmiValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="23.9"
                    android:textColor="#111111"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtBmiLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="BMI hiện tại"
                    android:textColor="#333333"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- THANH BMI -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:id="@+id/layoutBmiBar"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_centerVertical="true"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="3.5"
                            android:background="#75BDE3" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="6.5"
                            android:background="#63D44B" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="5"
                            android:background="#F2D22E" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="5"
                            android:background="#E89A2E" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="5"
                            android:background="#D9231F" />

                    </LinearLayout>

                    <View
                        android:id="@+id/viewBmiIndicator"
                        android:layout_width="5dp"
                        android:layout_height="26dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="#111111" />

                </RelativeLayout>

                <TextView
                    android:id="@+id/txtBmiStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="Bạn có chỉ số tuyệt vời! Hãy duy trì nhé!"
                    android:textColor="#666666"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- TỔNG KẾT -->
            <LinearLayout
                android:id="@+id/layoutSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Cân nặng hiện tại"
                            android:textColor="#999999"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtCurrentWeightSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center"
                            android:text="65.0 kg"
                            android:textColor="#111111"
                            android:textSize="25sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="46dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="»"
                        android:textColor="#BDEFC1"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Cân nặng mục tiêu"
                            android:textColor="#999999"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtTargetWeightSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center"
                            android:text="65.0 kg"
                            android:textColor="#111111"
                            android:textSize="25sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="54dp"
                    android:gravity="center"
                    android:text="Tuyệt vời!"
                    android:textColor="#74D97F"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="Bắt đầu xây dựng lộ trình tập trong 30 ngày nào"
                    android:textColor="#666666"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- LOADING -->
            <TextView
                android:id="@+id/txtLoadingPercent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="40%"
                android:textColor="#111111"
                android:textSize="58sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <!-- NÚT TIẾP THEO -->
        <TextView
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:background="@drawable/bg_green_button"
            android:gravity="center"
            android:text="Tiếp theo"
            android:textColor="#111111"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>