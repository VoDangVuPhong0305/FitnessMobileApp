<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollNutrition"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F2"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/layoutNutritionContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="42dp"
        android:paddingEnd="20dp"
        android:paddingBottom="116dp">

        <TextView
            android:id="@+id/txtNutritionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/anton_regular"
            android:includeFontPadding="false"
            android:text="ĂN UỐNG - DINH DƯỠNG"
            android:layout_marginTop="15dp"
            android:textColor="#222222"
            android:textSize="30sp"
            android:textStyle="normal" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMealPlan"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardUseCompatPadding="false"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@android:color/transparent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imgNutritionBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_nutrition_banner" />

                <!-- Khối chữ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="18dp">

                    <TextView
                        android:id="@+id/txtMealPlanTitle"
                        android:layout_width="185dp"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:text="Kế hoạch ăn uống \ntrong 30 ngày"
                        android:textColor="#222222"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/txtMealPlanSubtitle"
                        android:layout_width="205dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:text="Công thức nấu ăn miễn phí để bạn tham khảo"
                        android:textColor="#333333"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Nút mua sắm nằm riêng, bám đáy trái -->
                <LinearLayout
                    android:id="@+id/btnShoppingList"
                    android:layout_width="198dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|bottom"
                    android:layout_marginStart="0dp"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/bg_shopping_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_shopping_bag" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="Danh sách mua sắm"
                        android:textColor="#222222"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_right" />

                </LinearLayout>

            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <GridLayout
            android:id="@+id/gridMealDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:columnCount="3"
            android:useDefaultMargins="false" />

    </LinearLayout>

</ScrollView>